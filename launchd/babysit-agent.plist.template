<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template — `make start` substitutes the placeholders below and writes the real
  plist to ~/Library/LaunchAgents/. Nothing host-specific is committed here.

    __LABEL__      launchd label (LAUNCHD_LABEL in the Makefile)
    __NODE_BIN__   absolute path to the `node` that runs the daemon (nvm-safe)
    __WORKDIR__    this workspace's absolute path
    __HOME__       the invoking user's home dir
    __PATH__       PATH for the daemon (launchd starts with a bare one)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>

    <!-- Run the BUILT daemon directly — no npm wrapper, no `tsx watch`.
         This is load-bearing for KeepAlive, not a style choice. `tsx watch`
         outlives the child it spawns: when the daemon process dies, the watcher
         sits there waiting for a file change, so launchd still sees a live
         ProgramArguments process and never restarts anything. The result is a
         daemon that is down while `launchctl list` reports it healthy — one
         crash became a multi-day silent outage.

         Running node on dist/index.js makes the daemon BE the process launchd
         supervises: a crash is an exit, and KeepAlive restarts it in
         ThrottleInterval seconds. `make restart` rebuilds first, so editing
         source and restarting still picks up changes. -->
    <key>ProgramArguments</key>
    <array>
        <string>__NODE_BIN__</string>
        <string>__WORKDIR__/packages/server/dist/index.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__WORKDIR__</string>

    <!-- launchd starts with a bare PATH; the daemon shells out to `gh` (Homebrew),
         `git`, and `node` for the gate's build/test, so both dirs must be present. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <!-- Root all heavy state (SQLite + repo clones + worktrees + CI logs)
             under the workspace `.data/` — the SAME dir the Docker path
             bind-mounts. A native process reads it at full disk speed (none of
             the VirtioFS tax the container pays), so switching between the
             launchd and Docker paths reuses one state dir: base clones and any
             in-flight threads survive the switch. -->
        <key>BABYSIT_DATA_DIR</key>
        <string>__WORKDIR__/.data</string>
        <!-- Point at the root .env/config.json explicitly. `paths.ts` finds the
             workspace root on its own, but a missing config.json is a SILENT
             failure (defaults win, and the default is dryRun:true — a daemon
             that polls and logs normally while writing nothing). Naming both
             files here means a wrong path fails loudly instead. -->
        <key>BABYSIT_ENV_FILE</key>
        <string>__WORKDIR__/.env</string>
        <key>BABYSIT_CONFIG</key>
        <string>__WORKDIR__/config.json</string>
    </dict>

    <!-- Login item: start at load and keep it running. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Don't hammer restart-loop if it crashes on startup. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Logs live under the same `.data/` as state — one dir to tail. -->
    <key>StandardOutPath</key>
    <string>__WORKDIR__/.data/daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>__WORKDIR__/.data/daemon.err.log</string>
</dict>
</plist>
