# Copy to .env (gitignored) and fill in — or let `make docker-setup` write it
# for you (it prompts for and validates every value below).

# GitHub token. A PAT with `repo` scope, or `gh auth token` output. Used for
# both the GitHub API and raw `git push` (the entrypoint runs gh auth setup-git).
GH_TOKEN=ghp_...
GITHUB_TOKEN=ghp_...          # same value; some tools read one or the other

# Bedrock Token Vending Machine (TVM) — a service that mints short-lived Bedrock
# bearer tokens, so this agent never holds long-lived AWS credentials. Point it at
# your organization's token vendor; see packages/server/src/bedrock-auth.ts for the
# wire protocol (a signed POST /api/v1/tokens) if you implement your own.
BEDROCK_TVM_URL=https://tvm.example.internal
BEDROCK_TVM_KEY_ID=...        # key id issued by the TVM
BEDROCK_TVM_SECRET=...        # key secret (usually shown only once)
